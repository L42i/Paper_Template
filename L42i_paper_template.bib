%% =====================================================================
%%  references.bib  --  your bibliography
%%
%%  Add one entry per source. Cite it in the paper with \cite{key},
%%  where "key" is the label right after the entry type, e.g.
%%  \cite{trueman2006plork}. Only sources you cite show up in the paper.
%%
%%  The four entries below are real, on-topic examples that show the
%%  most common types (conference paper, book, journal article, and a
%%  software/web resource). Replace them with your own sources, or keep
%%  the ones you actually use.
%%
%%  Tip: keep the word "at-sign" out of your comments --- BibTeX reads
%%  every at-sign as the start of a new entry.
%% =====================================================================

%% A paper in conference proceedings --- the most common type in this field.
@inproceedings{trueman2006plork,
  author    = {Trueman, Dan and Cook, Perry and Smallwood, Scott and Wang, Ge},
  title     = {{PLOrk}: The {Princeton} Laptop Orchestra, Year 1},
  booktitle = {Proceedings of the International Computer Music Conference (ICMC)},
  publisher = {International Computer Music Association},
  year      = {2006},
  address   = {New Orleans, USA}
}

%% A book.
@book{puckette2007,
  author    = {Puckette, Miller},
  title     = {The Theory and Technique of Electronic Music},
  publisher = {World Scientific Publishing},
  year      = {2007},
  address   = {Singapore}
}

%% A journal article.
@article{mccartney2002,
  author  = {McCartney, James},
  title   = {Rethinking the Computer Music Language: {SuperCollider}},
  journal = {Computer Music Journal},
  volume  = {26},
  number  = {4},
  pages   = {61--68},
  year    = {2002}
}

%% Software or a web resource --- use the misc type, with a note and a URL.
@misc{supercollider,
  author       = {{The SuperCollider Community}},
  title        = {{SuperCollider}: A Platform for Audio Synthesis and Algorithmic Composition},
  howpublished = {\url{https://supercollider.github.io}},
  note         = {Software},
  year         = {2023}
}
